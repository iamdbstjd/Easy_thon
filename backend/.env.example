# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 깃에 올리지 않는다.
# 서버(app/main.py)가 시작할 때 backend/.env를 읽는다. 이미 설정된 환경변수는 덮어쓰지 않는다.

# Claude API 키 (platform.claude.com에서 발급).
# 없으면 /api/extract만 503(AI_FAILED)을 내고, /api/health·/api/demo·/api/check는 그대로 동작한다.
ANTHROPIC_API_KEY=

# API 키 대신 인증 토큰을 쓸 때만 채운다 (보통은 비워 둔다).
# ANTHROPIC_AUTH_TOKEN=

# /api/extract의 Claude 호출 전체(등기부+계약서, 재시도 포함) 마감 시간(초). 기본 85.
# 화면(서류 읽는 중)이 90초에 포기하므로 그보다 짧게 둔다. 넘으면 AI_FAILED(502).
# EXTRACT_DEADLINE_SECONDS=85
