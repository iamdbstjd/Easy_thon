# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 깃에 올리지 않는다.
# 서버(app/main.py)가 시작할 때 backend/.env를 읽는다. 이미 설정된 환경변수는 덮어쓰지 않는다.

# 서류를 읽을 AI 키. 둘 중 하나만 있으면 된다 (둘 다 있으면 OpenAI를 쓴다).
# 둘 다 없으면 /api/extract만 503(AI_FAILED)을 내고, /api/health·/api/demo·/api/check는 그대로 동작한다.

# OpenAI API 키 (platform.openai.com에서 발급).
OPENAI_API_KEY=
# 모델과 추론 강도. 기본 gpt-5.5, low. 추론 강도가 SDK가 받는 값(minimal·low·medium·high 등)이 아니면 경고를 남기고 low.
# OPENAI_MODEL=gpt-5.5
# OPENAI_REASONING_EFFORT=low

# Claude API 키 (platform.claude.com에서 발급).
ANTHROPIC_API_KEY=

# 두 키가 다 있을 때 쓸 쪽을 정한다: openai(또는 gpt) 또는 anthropic(또는 claude). 모르는 값이면 경고를 남기고 키로 고른다.
# AI_PROVIDER=openai

# API 키 대신 인증 토큰을 쓸 때만 채운다 (보통은 비워 둔다).
# ANTHROPIC_AUTH_TOKEN=

# /api/extract의 AI 호출 전체(등기부+계약서, 재시도 포함) 마감 시간(초). 기본 85.
# 화면(서류 읽는 중)이 90초에 포기하므로 그보다 짧게 둔다. 넘으면 AI_FAILED(502).
# EXTRACT_DEADLINE_SECONDS=85
